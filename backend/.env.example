# IVY_* env vars only; never commit secrets (SOC CC6.1).
IVY_APP_ENV=development
IVY_LOG_LEVEL=INFO
IVY_ENABLE_DOCS=true
# JSON list format for pydantic-settings:
IVY_CORS_ORIGINS='["http://localhost:5173"]'
# Auth (Phase 2 HS256 JWT). Set a long random value in staging/prod:
IVY_JWT_SECRET=dev-only-secret-change-in-prod
# IVY_JWT_ISSUER=ivy-dev
# IVY_JWT_AUDIENCE=ivy-learners
# IVY_JWT_EXP_MINUTES=60
# Postgres in compose/prod, SQLite file locally. Examples:
# IVY_DATABASE_URL=postgresql+psycopg://ivy:ivy@localhost:5432/ivy
# IVY_DATABASE_URL=sqlite:///./ivy.db
